# Скопируйте в .env для локального запуска (например через `pip install python-dotenv`
# и `from dotenv import load_dotenv; load_dotenv()` — по умолчанию бот читает
# переменные окружения напрямую, .env не грузится автоматически).
# На Render эти же значения задаются в Dashboard → Environment, а не в файле.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

SFTP_HOST=
SFTP_USER=
SFTP_PORT=22
# Вставляйте ключ одной строкой с \n вместо переносов, либо через
# Render "Secret File" / многострочное значение переменной — оба варианта
# поддерживаются кодом (см. normalize_private_key).
SSH_PRIVATE_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Максимальный размер архива аддона при загрузке по прямой ссылке (в МБ).
ADDON_MAX_DOWNLOAD_MB=300

# Опционально: путь к постоянному диску Render для хранения памяти бота
# и runtime-настроек SFTP между деплоями (см. render.yaml).
STATE_DIR=/var/data
